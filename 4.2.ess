start
new aone number
set aone 1
loop z (11 > aone)
    log number aone
    set aone aone + 1
end z
new a number
loop x (21 > a)
    log number a
    set a a + 2
end x
new b number
loop v (31 > b)
    log number b
    set b b + 3
end v
new c number
loop n (41 > c)
    log number c
    set c c + 4
end n
new d number
loop m (51 > d)
    log number d
    set d d + 5
end m
new e number
loop r (61 > e)
    log number e
    set e e + 6
end r
new f number
loop w (71 > f)
    log number f
    set f f + 7
end w
new g number
loop q (81 > g)
    log number g
    set g g + 8
end q
new h number
loop t (82 > h)
    log number h
    set h h + 9
end t
finish
